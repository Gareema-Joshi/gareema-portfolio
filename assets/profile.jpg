<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%" fill="none">
  <!-- Soft Bone Background Plate -->
  <rect width="400" height="400" rx="200" fill="#F2EFE7" stroke="#17221D" stroke-width="2" />
  <circle cx="200" cy="200" r="190" fill="#E8E4DA" stroke="#B56A4A" stroke-width="2" stroke-dasharray="4 4" />

  <!-- Avatar Silhouette Icon -->
  <circle cx="200" cy="150" r="50" fill="#17221D" />
  <path d="M 100,310 C 100,230 140,210 200,210 C 260,210 300,230 300,310 Z" fill="#17221D" />

  <!-- Monogram Badge Overlay -->
  <rect x="120" y="325" width="160" height="34" rx="4" fill="#17221D" stroke="#B56A4A" stroke-width="1.5" />
  <text x="200" y="347" text-anchor="middle" fill="#F2EFE7" font-family="'JetBrains Mono', monospace" font-size="13" font-weight="700">GAREEMA JOSHI</text>
</svg>
